{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["github-actions", "pip_requirements", "ansible-galaxy"],
  "dependencyDashboard": false,
  "packageRules": [
    {
      "description": "Pin all GitHub Actions to SHA digests",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "minimumReleaseAge": "7 days",
      "groupName": "Renovatebot GHA Updates"
    },
    {
      "description": "Group all pip dependency updates",
      "matchManagers": ["pip_requirements"],
      "minimumReleaseAge": "7 days",
      "groupName": "Renovatebot Pip Updates"
    },
    {
      "description": "Group all Ansible Galaxy dependency updates",
      "matchManagers": ["ansible-galaxy"],
      "minimumReleaseAge": "7 days",
      "groupName": "Renovatebot Ansible Galaxy Updates"
    }
  ]
}
